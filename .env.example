# Copie para .env (nunca commitado, ver .gitignore) e preencha os valores reais.

# DSN do projeto Sentry (Settings > Client Keys, depois de criar o projeto em
# sentry.io). Sem isso, iniciarObservabilidade() não faz nada - estado padrão,
# não erro. Não é segredo no sentido estrito (fica embutido no bundle que roda
# na máquina de quem usa o app), mas não precisa estar versionado mesmo assim.
VITE_SENTRY_DSN=

# Opcional: aparece nos eventos do Sentry para saber qual versão gerou o erro.
VITE_APP_VERSION=
