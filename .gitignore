# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Build de terceiros gerado (o app é empacotado via PyInstaller no lado
# Windows, não daqui; isso é sobra de uma tentativa anterior via electron-
# builder e artefatos binários do release, não faz sentido versionar).
build/
release/
build-app/
dist-app/
installer/
.build-venv/
*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Pasta de trabalho de sessão (PDFs intermediários da auditoria); nada aqui é
# referenciado por código ou teste.
tmp/

# Scripts descartáveis de auditoria, criados na raiz durante uma sessão e sem
# nenhuma referência no projeto.
*-audit-tmp.mjs

# Registro local de declarações do programa da Receita, copiado junto com os
# backups do preenchimento sintético. Lista as declarações REAIS existentes na
# máquina (nome, CPF, recibo de transmissão) e não pode ser versionado.
output/backup-irpf-sintetico/*/iddeclaracoes.*

# Versões superadas dos PDFs de gabarito. Só os três canônicos (AJU-01,
# ESP-01, SAI-01, sem sufixo) são referenciados por teste ou script.
output/pdf/*-PRE-*.pdf
output/pdf/*-33pag-*.pdf
output/pdf/*-41pag-*.pdf
output/pdf/*.microsoft-print-image-only-*.pdf

# Manifesto local das declarações reais (nomes de arquivo e valores pessoais
# esperados pelos testes). Mora fora do repositório; a regra existe para o caso
# de alguém copiá-lo para dentro por engano.
*.local.json

# Cache do Python do backend desktop
__pycache__/

# Estado de execução do modo live da impeccable (diário de sessões, raízes e
# registro de injeção). A configuração (.impeccable/live/config.json) e o
# sidecar do sistema visual (.impeccable/design.json) são versionados.
.impeccable/live/sessions/
.impeccable/live/roots.json
.impeccable/live/inject-journal.json
.impeccable/live/server.json
.impeccable/hook.cache.json

# Saída do MCP do Playwright (instantâneos e log de console de sessão de teste)
.playwright-mcp/

# Saída do Playwright Test (e2e): relatório HTML, screenshots/traces de falha
playwright-report/
test-results/

# Relatório de cobertura do vitest (gerado, sobe pro Codecov via CI)
coverage/

# Configuração de desenvolvimento local desta worktree (libera o caminho real do
# node_modules para o Vite servir a fonte Inter).
vite.live.config.mjs
