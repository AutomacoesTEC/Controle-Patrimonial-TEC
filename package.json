{
  "name": "controle-patrimonial",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:full": "cross-env IRPF_FIXTURES_REQUIRED=1 vitest run",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:changed": "biome check --changed --no-errors-on-unmatched .",
    "lint:staged": "biome check --staged --no-errors-on-unmatched .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.3.1",
    "jsdom": "^25.0.1",
    "simple-git-hooks": "^2.14.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint:staged",
    "commit-msg": "npx --no-install commitlint --edit $1"
  }
}
